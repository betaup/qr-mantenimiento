# Copia este archivo como .env y ajusta los valores. El .env nunca se sube al repositorio.

DATABASE_URL="file:./dev.db"

# Dirección pública de la aplicación; con ella se arman los códigos QR.
APP_URL="http://localhost:3000"

# Contraseña de las cuentas de prueba que crea prisma/seed.ts.
# Usa una larga y aleatoria, por ejemplo: openssl rand -base64 18
SEED_PASSWORD=""
